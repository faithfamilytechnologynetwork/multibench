# MultiBench API (apps/api) — Spec 92.
#
# UNLIKE the multibrowser SPA, this service DOES hold secrets (the DB URL). Secrets live in the
# Railway environment, never in the static SPA — the SPA stays secret-free; the API holds credentials.

# Postgres connection string (Railway provides this for the linked Postgres service). Required.
DATABASE_URL=postgres://user:pass@host:5432/dbname

# Comma-separated list of allowed browser origins for CORS (credentialed cross-site requests).
# The SPA and API are separate Railway origins, so the SPA origin must be listed here for the
# cross-site session cookie (added in Phase 2) to work. Never use "*" with credentials.
ALLOWED_ORIGINS=http://localhost:4173,http://localhost:5173

# Port the service listens on. Railway sets PORT automatically; 8080 is the local default.
PORT=8080

# Shared signup invite code (Spec 92). Signup is gated on this single shared secret — reviewers must
# present it to create an account. FAIL-CLOSED: if unset, signup is disabled entirely (login still
# works). No email/magic-link is involved.
REVIEW_INVITE_CODE=change-me

# (No serving-tier / version / fingerprint vars yet — those arrive with the deferred serving tiers,
#  Phase 5+. No email/magic-link vars — auth is email+password, Phase 2.)
