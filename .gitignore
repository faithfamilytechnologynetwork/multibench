# Codev
.agent-farm/
.consult/
codev/.update-hashes.json
# porch per-project consult artifacts (rebuttals, context, revision briefs) — intermediate
# process output, not deliverables (the review distills them; specs/plans/reviews + codev/state/
# threads are the durable record). status.yaml is porch's own committed state — keep it tracked.
codev/projects/*/*
!codev/projects/*/status.yaml
# architect state log is local-only (public repo); builder *_thread.md files stay tracked
codev/state/main.md
.builders/
.architect-role.md

# Dependencies
node_modules/

# Build output
dist/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# JaleesBench source staging (port input; never committed)
tmp/

# Builder spawn artifacts
.builder-*

# OS files
.DS_Store
*.swp
*.swo

# Codev (added by codev update 2026-07-22)
codev/state/*.md
!codev/state/*_thread.md

# Harness-local hooks (worktree write-guard etc.) — not a repo artifact
.claude/hooks/
